# Facoltativo: ./start.sh funziona senza questo file.
AUDIENCE_OLLAMA_MODEL=qwen3.5:4b
AUDIENCE_OLLAMA_URL=http://127.0.0.1:11434

# Cloud facoltativo (si può configurare anche dall'app, in Impostazioni → Motore AI).
# Usa account Free Tier / Workers Free: la chiave non permette di verificare il piano di fatturazione.
AUDIENCE_GEMINI_API_KEY=
AUDIENCE_GEMINI_FREE_TIER_CONFIRMED=false
AUDIENCE_GEMINI_REQUESTS_PER_MINUTE=10
AUDIENCE_CLOUDFLARE_API_TOKEN=
AUDIENCE_CLOUDFLARE_ACCOUNT_ID=
AUDIENCE_CLOUDFLARE_FREE_TIER_CONFIRMED=false
AUDIENCE_CLOUDFLARE_REQUESTS_PER_MINUTE=30

# Concorrenza delle sole reazioni locali (1-4); coordinare con OLLAMA_NUM_PARALLEL in Ollama.
AUDIENCE_OLLAMA_REACTION_CONCURRENCY=1

# Local zero-service development. Compose supplies PostgreSQL/Redis/S3 internally.
AUDIENCE_DATABASE_URL=sqlite:///artifacts/audience.db
AUDIENCE_DATA_DIR=data
AUDIENCE_ARTIFACT_DIR=artifacts
AUDIENCE_OLLAMA_URL=http://127.0.0.1:11434
AUDIENCE_OLLAMA_MODEL=qwen3.5:9b
AUDIENCE_QUEUE_MODE=local
AUDIENCE_MAX_EVALUATIONS=5000
AUDIENCE_MONTE_CARLO_DRAWS=1000

# Optional cloud credentials; the app can also store them in private artifacts files.
# Use Free Tier/Workers Free accounts; the API key cannot prove account billing status.
AUDIENCE_GEMINI_API_KEY=
AUDIENCE_GEMINI_FREE_TIER_CONFIRMED=false
AUDIENCE_GEMINI_REQUESTS_PER_MINUTE=10
AUDIENCE_CLOUDFLARE_API_TOKEN=
AUDIENCE_CLOUDFLARE_ACCOUNT_ID=
AUDIENCE_CLOUDFLARE_FREE_TIER_CONFIRMED=false
AUDIENCE_CLOUDFLARE_REQUESTS_PER_MINUTE=30

# Concorrenza delle sole reazioni locali (1-4); coordinare con OLLAMA_NUM_PARALLEL nel server Ollama.
AUDIENCE_OLLAMA_REACTION_CONCURRENCY=1

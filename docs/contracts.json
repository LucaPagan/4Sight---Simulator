{
  "Creative": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "headline": {
        "maxLength": 250,
        "minLength": 1,
        "title": "Headline",
        "type": "string"
      },
      "primary_text": {
        "maxLength": 4000,
        "minLength": 1,
        "title": "Primary Text",
        "type": "string"
      },
      "visual_description": {
        "default": "",
        "maxLength": 2000,
        "title": "Visual Description",
        "type": "string"
      },
      "cta": {
        "default": "Scopri di più",
        "maxLength": 100,
        "title": "Cta",
        "type": "string"
      },
      "lever": {
        "default": "value",
        "enum": [
          "scarcity",
          "urgency",
          "black_friday",
          "value"
        ],
        "title": "Lever",
        "type": "string"
      },
      "format": {
        "default": "immagine",
        "enum": [
          "immagine",
          "video",
          "carosello"
        ],
        "title": "Format",
        "type": "string"
      },
      "claim_verified": {
        "default": false,
        "title": "Claim Verified",
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "headline",
      "primary_text"
    ],
    "title": "Creative",
    "type": "object"
  },
  "CampaignBrief": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "maxLength": 150,
        "minLength": 1,
        "title": "Name",
        "type": "string"
      },
      "brand": {
        "maxLength": 150,
        "minLength": 1,
        "title": "Brand",
        "type": "string"
      },
      "product_description": {
        "maxLength": 3000,
        "minLength": 3,
        "title": "Product Description",
        "type": "string"
      },
      "vertical": {
        "enum": [
          "beauty_skincare",
          "pet_ecommerce",
          "abbigliamento"
        ],
        "title": "Vertical",
        "type": "string"
      },
      "objective": {
        "default": "vendite",
        "enum": [
          "vendite",
          "traffico"
        ],
        "title": "Objective",
        "type": "string"
      },
      "platform": {
        "const": "meta",
        "default": "meta",
        "title": "Platform",
        "type": "string"
      },

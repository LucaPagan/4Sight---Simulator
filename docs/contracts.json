        "default": "IT",
        "enum": [
          "IT",
          "ES",
          "FR",
          "DE"
        ],
        "title": "Country",
        "type": "string"
      },
      "date_from": {
        "default": "2026-11-16",
        "format": "date",
        "title": "Date From",
        "type": "string"
      },
      "date_to": {
        "default": "2026-11-30",
        "format": "date",
        "title": "Date To",
        "type": "string"
      },
      "daily_adset_budget_eur": {
        "default": 150,
        "maximum": 100000,
        "minimum": 0,
        "title": "Daily Adset Budget Eur",
        "type": "number"
      },
      "creatives": {
        "items": {
          "$ref": "#/$defs/Creative"
        },
        "maxItems": 4,
        "title": "Creatives",
        "type": "array"
      },
      "population_size": {
        "const": 120,
        "default": 120,
        "title": "Population Size",
        "type": "integer"
      },
      "seed": {
        "default": 42,
        "maximum": 2147483647,
        "minimum": 0,
        "title": "Seed",
        "type": "integer"
      },
      "age_shares": {
        "items": {
          "type": "number"
        },
        "maxItems": 6,
        "minItems": 6,
        "title": "Age Shares",
        "type": "array"
      },
      "age_effects": {
        "items": {
          "type": "number"
        },
        "maxItems": 6,
        "minItems": 6,
        "title": "Age Effects",
        "type": "array"
      },
      "sensitivity_profile": {
        "default": "central",
        "enum": [
          "conservative",
          "central",
          "exploratory"
        ],
        "title": "Sensitivity Profile",
        "type": "string"
      },
      "prior_strength": {
        "default": 1.0,
        "maximum": 2,
        "minimum": 0,
        "title": "Prior Strength",
        "type": "number"
      },
      "placement": {
        "default": "instagram_feed",
        "enum": [
          "instagram_feed",
          "facebook_feed",
          "instagram_stories"
        ],
        "title": "Placement",
        "type": "string"
      },
      "browsing_task": {
        "default": "casual_scrolling",
        "enum": [
          "casual_scrolling",
          "product_research",
          "comparison_shopping"
        ],
        "title": "Browsing Task",
        "type": "string"
      },
      "price_eur": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Price Eur"
      },
      "notes": {
        "default": "",
        "maxLength": 2000,
        "title": "Notes",
        "type": "string"
      }
    },
    "required": [
      "name",
      "brand",
      "product_description",
      "vertical"
    ],
    "title": "CampaignBrief",
    "type": "object"
  },

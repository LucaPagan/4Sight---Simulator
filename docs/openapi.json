  "components": {
    "schemas": {
      "AgePrediction": {
        "properties": {
          "age_band": {
            "type": "string",
            "title": "Age Band"
          },
          "impression_share": {
            "type": "number",
            "title": "Impression Share"
          },
          "ctr_estimate": {
            "type": "number",
            "title": "Ctr Estimate"
          },
          "ctr_range": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ctr Range"
          },
          "expected_impressions": {
            "type": "number",
            "title": "Expected Impressions"
          },
          "clicks_estimate": {
            "type": "number",
            "title": "Clicks Estimate"
          },
          "expected_spend": {
            "type": "number",
            "title": "Expected Spend"
          },
          "evidence_level": {
            "type": "string",
            "title": "Evidence Level"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "age_band",
          "impression_share",
          "ctr_estimate",
          "ctr_range",
          "expected_impressions",
          "clicks_estimate",
          "expected_spend",
          "evidence_level"
        ],
        "title": "AgePrediction"
      },
      "Body_import_files_api_v1_datasets_import_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_import_files_api_v1_datasets_import_post"
      },
      "CampaignBrief": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Brand"
          },
          "product_description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 3,
            "title": "Product Description"
          },
          "vertical": {
            "type": "string",
            "enum": [
              "beauty_skincare",
              "pet_ecommerce",
              "abbigliamento"
            ],
            "title": "Vertical"
          },
          "objective": {
            "type": "string",
            "enum": [
              "vendite",
              "traffico"
            ],
            "title": "Objective",
            "default": "vendite"
          },
          "platform": {
            "type": "string",
            "const": "meta",
            "title": "Platform",
            "default": "meta"
          },
          "country": {
            "type": "string",
            "enum": [
              "IT",
              "ES",
              "FR",
              "DE"
            ],
            "title": "Country",
            "default": "IT"
          },
          "date_from": {
            "type": "string",
            "format": "date",
